{
  "name": "ESP32 + DHT22",
  "version": "0.1.0",
  "components": [
    { "type": "esp32dev", "id": "esp32", "x": 100, "y": 100 },
    { "type": "dht22", "id": "dht", "x": 300, "y": 100 },
    { "type": "resistor", "id": "r1", "x": 220, "y": 70, "properties": { "resistance": "4.7k" } }
  ],
  "connections": [
    { "from": "dht:VCC",  "to": "esp32:3V3" },
    { "from": "dht:GND",  "to": "esp32:GND" },
    { "from": "dht:DATA", "to": "esp32:GPIO23" },
    { "from": "dht:DATA", "to": "r1:1" },
    { "from": "r1:2",     "to": "esp32:3V3" }
  ]
}
